{
  "info": {
    "name": "Session Booking API",
    "description": "Postman collection for the Session Booking backend. Run requests in order: Create Teacher -> Create User -> Create Session -> Available Sessions -> Book -> Complete -> User Sessions. IDs are stored automatically in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "teacherId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "startTime", "value": "" },
    { "key": "dateTimestamp", "value": "" }
  ],
  "item": [
    {
      "name": "0. Create Teacher (helper)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('teacherId', pm.response.json().data._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Anita Sharma\",\n  \"email\": \"anita.sharma@example.com\",\n  \"specialization\": \"Mathematics\",\n  \"experience\": 8\n}"
        },
        "url": { "raw": "{{baseUrl}}/teachers", "host": ["{{baseUrl}}"], "path": ["teachers"] }
      }
    },
    {
      "name": "1. Create User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.collectionVariables.set('uniqueEmail', 'user' + Date.now() + '@example.com');"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('userId', pm.response.json().data._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Parag Aggarwal\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"phone\": \"+919876543210\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
      }
    },
    {
      "name": "2. Create Session",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const start = new Date(Date.now() + 24 * 60 * 60 * 1000);",
              "start.setUTCHours(10, 0, 0, 0);",
              "const end = new Date(start.getTime() + 60 * 60 * 1000);",
              "pm.collectionVariables.set('startTime', start.toISOString());",
              "pm.collectionVariables.set('endTime', end.toISOString());",
              "pm.collectionVariables.set('dateTimestamp', String(start.getTime()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const d = pm.response.json().data;",
              "pm.test('status is AVAILABLE', () => pm.expect(d.status).to.eql('AVAILABLE'));",
              "pm.collectionVariables.set('sessionId', d._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/sessions", "host": ["{{baseUrl}}"], "path": ["sessions"] }
      }
    },
    {
      "name": "3. Available Sessions (by date)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const ids = pm.response.json().data.map(s => s._id);",
              "pm.test('contains created session', () => pm.expect(ids).to.include(pm.collectionVariables.get('sessionId')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "available"],
          "query": [{ "key": "dateTimestamp", "value": "{{dateTimestamp}}" }]
        }
      }
    },
    {
      "name": "4. Book Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('status is BOOKED', () => pm.expect(pm.response.json().data.status).to.eql('BOOKED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\"\n}" },
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "book"]
        }
      }
    },
    {
      "name": "5. Mark Session Complete",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "pm.test('COMPLETED with completedAt', () => { pm.expect(d.status).to.eql('COMPLETED'); pm.expect(d.completedAt).to.be.a('string'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "complete"]
        }
      }
    }
  ]
}
